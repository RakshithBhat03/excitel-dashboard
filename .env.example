# Copy this file to .env and replace only the placeholder values.
# Never commit .env or put real credentials in this file.

# PostgreSQL configuration
POSTGRES_DB=excitel
POSTGRES_USER=excitel
POSTGRES_PASSWORD=your_secure_password_here

# Excitel API credentials
# EXCITEL_USERNAME and EXCITEL_PASSWORD can be omitted when SELFCARE_COOKIE is set.
EXCITEL_USERNAME=your_excitel_username
EXCITEL_PASSWORD=your_excitel_password
# Optional: a current selfcare cookie. Treat it like a password and never commit it.
SELFCARE_COOKIE=

# Allowed browser origins for direct local backend development.
# Docker serves the frontend and API from the same origin.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Only needed when running the backend or worker directly outside Docker.
# DATABASE_URL=postgres://excitel:your_secure_password_here@127.0.0.1:5432/excitel

# Cron Schedule (default: every 2 hours)
SYNC_CRON_SCHEDULE=0 */2 * * *

# Daily database backup schedule (default: 2 AM UTC every day)
BACKUP_CRON_SCHEDULE=0 2 * * *

# Number of days to keep daily backups (default: 30)
BACKUP_RETENTION_DAYS=30

# Run sync on container startup
RUN_ON_STARTUP=true
