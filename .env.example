# PostgreSQL Configuration
POSTGRES_DB=excitel
POSTGRES_USER=excitel
POSTGRES_PASSWORD=your_secure_password_here

# Excitel API Credentials
EXCITEL_USERNAME=your_excitel_username
EXCITEL_PASSWORD=your_excitel_password

# Cron Schedule (default: every 2 hours)
SYNC_CRON_SCHEDULE=0 */2 * * *

# Run sync on container startup
RUN_ON_STARTUP=true
