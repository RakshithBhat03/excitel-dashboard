{
  "name": "excitel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run theme:init && vite",
    "build": "bun run theme:init && bun run typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "bun test",
    "theme:init": "bun build scripts/theme-init.ts --outfile public/theme-init.js --target browser --format iife --minify",
    "typecheck": "tsc -p tsconfig.frontend.json && tsc -p tsconfig.tooling.json",
    "typecheck:backend": "cd backend && bun run typecheck",
    "typecheck:worker": "cd worker && bun run typecheck",
    "typecheck:all": "bun run typecheck && bun run typecheck:backend && bun run typecheck:worker"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.4",
    "@types/node": "^24.10.1",
    "bun-types": "^1.3.5"
  }
}
